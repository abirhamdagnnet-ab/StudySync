NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/education
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7day
CORS_ORIGIN=http://localhost:5173
# Gemini credentials are used by the backend only and are never returned to clients.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=30000
# Set both values before running npm run seed to create the first admin.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
